# Copy to .env.local and fill in. Never commit .env.local.

# Local Qwen through Ollama
OLLAMA_URL=http://localhost:11434
# 8 GB Mac: qwen3:4b-instruct + qwen2.5vl:3b. Windows PC (RTX 5060 8 GB): qwen3:8b + qwen2.5vl:7b
# Use an "instruct" model: "thinking" models are slow and print their thoughts.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Search by meaning (English + Arabic). Changing it rebuilds the index on the next ingest.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Supabase (optional for now; feedback is saved to .data/feedback.jsonl when empty)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin page for city ratings (/admin). At least 12 characters. Empty or shorter = admin page off.
ADMIN_PASSWORD=
